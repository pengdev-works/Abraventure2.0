# Server Configuration
PORT=5000

# Database Connection String (PostgreSQL / NeonDB)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abraventure

# Authentication / Security
JWT_SECRET=replace_with_a_secure_random_secret_key

# Cloudinary Media Storage (Optional / Required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
